# Lascia vuoto per la modalità dimostrativa (regole).
# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Oppure qualsiasi API compatibile OpenAI (OpenAI, Ollama, OpenRouter, regolo.ai…)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Forza un fornitore: anthropic | openai | mock
LLM_PROVIDER=

# Accesso (lascia vuoto per l'uso locale senza password)
ACCESS_PASSWORD=
ADMIN_PASSWORD=
# Chiave per firmare le sessioni (se vuota viene generata in DATA_DIR)
SECRET_KEY=
# Cartella dei dati persistenti (su Railway: il percorso del volume, es. /data)
DATA_DIR=
